APP_NAME=AI Brain - GOD Cerebro Core
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60

DATABASE_URL=sqlite:///./data/brain.db

AUTONOMY_LEVEL=2
# 0=Chat, 1=Research, 2=Tools, 3=Automation, 4=Autonomous

MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=50
TOOL_TIMEOUT=30

WORKSPACE_PATH=./data/workspace
DOCUMENTS_PATH=./data/documents
LOG_PATH=./data/logs
MEMORY_PATH=./data/memory

SECRET_KEY=change-me-in-production
CORS_ORIGINS=*

# Security
ALLOW_FILE_WRITE=true
ALLOW_PYTHON_EXEC=false
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
