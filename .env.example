APP_NAME=AI Brain - GOD Cerebro Core
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60

DATABASE_URL=sqlite:///./data/brain.db

AUTONOMY_LEVEL=2
# 0=Chat, 1=Research, 2=Tools, 3=Automation, 4=Autonomous

MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=50
TOOL_TIMEOUT=30

WORKSPACE_PATH=./data/workspace
DOCUMENTS_PATH=./data/documents
LOG_PATH=./data/logs
MEMORY_PATH=./data/memory

SECRET_KEY=change-me-in-production
CORS_ORIGINS=*
API_KEY=
# Opcional — se setada, exige X-API-Key header — gera com: openssl rand -hex 32

# Security
ALLOW_FILE_WRITE=true
ALLOW_PYTHON_EXEC=false
REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# LLM Providers — Custo 0 free forever sem cartão
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
HF_TOKEN=

# Cloudflare Workers AI — NOVO — token cfat_... recebido
CLOUDFLARE_API_TOKEN=cfat_...
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=ai-brain-god
CLOUDFLARE_MODEL=@cf/meta/llama-3-8b-instruct
# Como obter:
# Account ID: https://dash.cloudflare.com → URL: /<ACCOUNT_ID>/...
# Token: https://dash.cloudflare.com/profile/api-tokens → Create Token → Workers AI + R2 + Workers
# Gateway ID: https://dash.cloudflare.com → AI → AI Gateway → Create Gateway

# Supabase Storage 1GB free
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=workspace

# Cloudflare R2 10GB free — S3 compat (além de cfat_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=workspace
# Cria em https://dash.cloudflare.com/r2 → Manage R2 API Tokens → Create Token

# Deploy tokens
GITHUB_TOKEN=
GITHUB_REPO=rpolicarpo100/APP_Teste
NETLIFY_TOKEN=
VERCEL_TOKEN=
CLOUDFLARE_TOKEN=

# Database — Neon 0.5GB free permanente
DATABASE_URL=postgresql://neondb_owner:npg_D1kFH0lYPvAi@ep-muddy-brook-adc8sq9j-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

# Search & Transcription
SERPER_API_KEY=
ASSEMBLYAI_API_KEY=
